//@version=6
indicator("FX AI Data Collector v1", overlay=true)

ema20=ta.ema(close,20)
ema50=ta.ema(close,50)
ema200=ta.ema(close,200)
sma200=ta.sma(close,200)
rsi8=ta.rsi(close,8)
rsi14=ta.rsi(close,14)
atr14=ta.atr(14)
bbBasis=ta.sma(close,20)
bbDev=ta.stdev(close,20)
bbZ=bbDev!=0?(close-bbBasis)/bbDev:0
vwapValue=ta.vwap(hlc3)
body=math.abs(close-open)
upperWick=high-math.max(open,close)
lowerWick=math.min(open,close)-low

ema20_1H=request.security(syminfo.tickerid,"60",ta.ema(close,20))
ema50_1H=request.security(syminfo.tickerid,"60",ta.ema(close,50))
ema200_1H=request.security(syminfo.tickerid,"60",ta.ema(close,200))
ema20_4H=request.security(syminfo.tickerid,"240",ta.ema(close,20))
ema50_4H=request.security(syminfo.tickerid,"240",ta.ema(close,50))
ema200_4H=request.security(syminfo.tickerid,"240",ta.ema(close,200))

msg='{"symbol":"'+syminfo.ticker+'","timeframe":"'+timeframe.period+'","time":'+str.tostring(time)+',"open":'+str.tostring(open)+',"high":'+str.tostring(high)+',"low":'+str.tostring(low)+',"close":'+str.tostring(close)+',"volume":'+str.tostring(volume)+',"ema20":'+str.tostring(ema20)+',"ema50":'+str.tostring(ema50)+',"ema200":'+str.tostring(ema200)+',"sma200":'+str.tostring(sma200)+',"rsi8":'+str.tostring(rsi8)+',"rsi14":'+str.tostring(rsi14)+',"atr14":'+str.tostring(atr14)+',"bb_z":'+str.tostring(bbZ)+',"vwap":'+str.tostring(vwapValue)+',"body":'+str.tostring(body)+',"upper_wick":'+str.tostring(upperWick)+',"lower_wick":'+str.tostring(lowerWick)+',"ema20_1h":'+str.tostring(ema20_1H)+',"ema50_1h":'+str.tostring(ema50_1H)+',"ema200_1h":'+str.tostring(ema200_1H)+',"ema20_4h":'+str.tostring(ema20_4H)+',"ema50_4h":'+str.tostring(ema50_4H)+',"ema200_4h":'+str.tostring(ema200_4H)+'}'

if barstate.isconfirmed
    alert(msg,alert.freq_once_per_bar_close)

plot(ema20)
plot(ema50)
plot(ema200)
